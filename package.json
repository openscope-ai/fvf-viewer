{
  "name": "fvf-viewer",
  "version": "0.8.1",
  "private": true,
  "type": "module",
  "description": "Professional browser-based viewer for Fluke ScopeMeter .fvf waveform captures",
  "packageManager": "pnpm@10.34.5",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm run build:wasm && pnpm --filter @fvf/web dev",
    "build": "pnpm -r build",
    "build:wasm": "pnpm --filter @fvf/fvf-wasm build",
    "lint": "eslint . && prettier --check .",
    "typecheck": "tsc --noEmit && pnpm -r typecheck",
    "test": "vitest run",
    "test:e2e": "playwright test"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "1.62.1",
    "@types/node": "^22.20.1",
    "@vitest/browser-playwright": "4.1.11",
    "eslint": "^10.9.1",
    "globals": "^17.11.0",
    "playwright": "^1.56.0",
    "prettier": "^3.9.6",
    "tsx": "^4.23.13",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.69.0",
    "vitest": "^4.1.11"
  }
}
